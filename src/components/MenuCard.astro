---
import type { MenuItem } from "../data/types";
import { formatPrice } from "../lib/format";

interface Props {
  item: MenuItem;
}

const { item } = Astro.props;

// Un ícono simple por categoría (trazos SVG, decorativos).
const icons: Record<MenuItem["category"], string> = {
  cafes:
    "M5 9h11v5a5 5 0 0 1-5 5h-1a5 5 0 0 1-5-5V9Zm11 1h1.5a2.5 2.5 0 0 1 0 5H16M8 3c0 1.5 1 1.5 1 3M12 3c0 1.5 1 1.5 1 3",
  frias: "M6 4h12l-1.5 16h-9L6 4Zm1 5h10M14 2l-2 7",
  panaderia:
    "M4 15c0-5 4-9 8-9s8 4 8 9c0 1.5-1 2.5-2.5 2.5h-11C5 17.5 4 16.5 4 15Zm5-6 1.5 8.5M15 9l-1.5 8.5",
};
---

<li class="flex gap-4 rounded-2xl bg-white/70 p-5 shadow-sm ring-1 ring-espresso/5">
  <span
    class="grid size-12 shrink-0 place-items-center rounded-full bg-salvia/20 text-espresso"
    aria-hidden="true"
  >
    <svg
      viewBox="0 0 24 24"
      class="size-6"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d={icons[item.category]}></path>
    </svg>
  </span>
  <div class="flex-1">
    <div class="flex items-baseline justify-between gap-3">
      <h4 class="font-display text-xl font-semibold">{item.name}</h4>
      <p class="font-semibold whitespace-nowrap text-terracota-oscuro">
        {formatPrice(item.price)}
      </p>
    </div>
    <p class="mt-1 text-espresso/80">{item.description}</p>
  </div>
</li>
