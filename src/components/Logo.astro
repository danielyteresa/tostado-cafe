---
import { site } from "../data/site";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={["inline-flex items-center gap-2", className]}>
  <svg viewBox="0 0 64 64" class="size-8 shrink-0" aria-hidden="true">
    <rect width="64" height="64" rx="14" fill="#3B2416"></rect>
    <g transform="rotate(-30 32 32)">
      <ellipse cx="32" cy="32" rx="14" ry="20" fill="#C8553D"></ellipse>
      <path
        d="M26 16c8 8 4 24 12 32"
        stroke="#3B2416"
        stroke-width="3"
        fill="none"
        stroke-linecap="round"
      ></path>
    </g>
  </svg>
  <span class="font-display text-2xl font-semibold">{site.name}</span>
</span>
